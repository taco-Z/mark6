DirectoryIndex public/index.cgi

Options -Indexes
<FilesMatch "\.(?:json|jsonl|lock|tmp)(?:\.|$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block private data before existing-file bypass.
  RewriteRule ^(?:dat|logs|lib|tools|t|docs|extensions|\.git)(?:/|$) - [F,L,NC]

  # /assets/... を public/assets/... として配信
  RewriteRule ^assets/(.+)$ public/assets/$1 [L]

  # public配下のアセットはCGIへ渡さない
  RewriteRule ^public/assets/ - [L]

  # 実在するファイル・ディレクトリはそのまま配信
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # それ以外は公開CGIへ
  RewriteRule ^(.*)$ public/index.cgi?path=$1 [L,QSA]
</IfModule>
